       return
     }
 
     if animation == nil {
-      initializeAnimation(fromValue: prevKeyboardPosition, toValue: keyboardHeight)
+      initializeAnimation(fromValue: prevKeyboardPosition, toValue: transitionTarget ?? keyboardHeight)
     }
 
